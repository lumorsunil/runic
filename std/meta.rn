// std.meta — generic, comptime-derived operations over any value, built on the
// comptime field-introspection surface (`@kind`, `@fields`, `@field`). These are
// the "derived" helpers a hand-written generic can't express without looking
// *inside* a value's fields: a structural dump and a structural equality that
// work for any struct, scalar, or string without per-type boilerplate.
//
// Each function is monomorphized per argument type: the `@kind(T)` test folds at
// compile time (the untaken branch is never emitted), and `for (@fields(T))`
// unrolls one copy per field with `f.name` bound, so `@field(v)(f.name)` is an
// ordinary field read in the generated code.
fn Void @() Void

// A readable dump of any value. A struct renders as `{ name=value … }` over its
// fields (in declaration order); a scalar/string renders as itself. Field values
// render with the usual string coercion, so nested structs show their own
// bracketed form only if their field type also routes here — `show` itself is one
// level (it does not recurse into struct-typed fields).
pub fn Void show(v: |T|) String {
  if (@kind(T) == "struct") {
    var out = "{ "
    for (@fields(T)) |f| { out = "${out}${f.name}=${@field(v)(f.name)} " }
    yield "${out}}"
  } else {
    yield "${v}"
  }
}

// Structural equality: a struct compares field-by-field (each field with `!=`),
// two scalars/strings compare with `==`. This is a single level — struct-typed
// fields compare with `!=`'s own semantics rather than recursing — which is exact
// for the common case of structs whose fields are scalars or strings.
pub fn Void eq(a: |T|, b: T) Bool {
  if (@kind(T) == "struct") {
    var ok = true
    for (@fields(T)) |f| {
      if (@field(a)(f.name) != @field(b)(f.name)) { ok = false }
    }
    yield ok
  } else {
    yield a == b
  }
}
