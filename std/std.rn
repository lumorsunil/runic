// std — the Runic standard library root. `const std = import "std"` resolves
// here (a bundled, reserved import); each standard module is a public member.
//
//   const std = import "std"
//   const doubled = std.list.map xs dbl
//
// Modules are kept narrow and mostly written in Runic. See docs/standard-library.md.
fn Void @() Void

pub const list = import "std/list"
pub const str = import "std/str"
