// std.env — environment access. `$NAME` reads a *statically named* variable;
// the lookup-by-string helpers wrap `printenv <name>` so the name can be
// dynamic. (`set` is not yet provided — a dynamic-name write needs a builtin.)
fn Void @() Void

// The value of `name`, or absent. Wraps `printenv <name>` (trailing newline
// stripped; an unset variable prints nothing and exits non-zero).
pub fn Void get(name: String) ?String {
  const v: String = "${printenv name}"
  const t = v.trim
  if (t.len == 0) { yield null } else { yield t }
}

// The value of `name`, or `default` when unset.
pub fn Void getOr(name: String, default: String) String {
  const v: String = "${printenv name}"
  const t = v.trim
  if (t.len == 0) { yield default } else { yield t }
}

// Whether `name` is set to a non-empty value.
pub fn Void has(name: String) Bool {
  const v: String = "${printenv name}"
  yield (v.trim.len) > 0
}

// Set `name` to `value` in the current subshell context (visible to later reads
// and to child processes spawned in this context). Backed by the `setenv`
// builtin — the dynamic-name counterpart of `$NAME = value`.
pub fn Void set(name: String, value: String) Void {
  setenv name value
}

// `$HOME`, or a sensible fallback.
pub fn Void home() String {
  const h = $HOME orelse "/tmp"
  yield h
}

// `$PATH` split on ":", empty segments dropped.
pub fn Void path() []String {
  const p: String = "${$PATH orelse ""}"
  var result = .{ }
  for (p.split ":") |part| {
    if (part.len > 0) { result = result.push part }
  }
  yield result
}
