// std.math — numeric helpers. The Int helpers are pure Runic; Float functions
// backed by builtins are added once those builtins exist.
fn Void @() Void

// Absolute value.
pub fn Void abs(n: Int) Int {
  if (n < 0) { yield 0 - n } else { yield n }
}

// Smaller of two.
pub fn Void min(a: Int, b: Int) Int {
  if (a < b) { yield a } else { yield b }
}

// Larger of two.
pub fn Void max(a: Int, b: Int) Int {
  if (a > b) { yield a } else { yield b }
}

// Constrain `n` to the inclusive range `[lo, hi]`.
pub fn Void clamp(n: Int, lo: Int, hi: Int) Int {
  if (n < lo) {
    yield lo
  } else {
    if (n > hi) { yield hi } else { yield n }
  }
}

// -1, 0, or 1 for a negative, zero, or positive value.
pub fn Void sign(n: Int) Int {
  if (n < 0) {
    yield 0 - 1
  } else {
    if (n > 0) { yield 1 } else { yield 0 }
  }
}

// Integer power `base ^ exp` for `exp >= 0` (0 for negative exponents).
pub fn Void pow(base: Int, exp: Int) Int {
  var result = 1
  for (0..exp) |_| { result = result * base }
  yield result
}

// Float helpers, backed by the Float-math builtins.

// Absolute value of a Float.
pub fn Void absF(x: Float) Float {
  if (x < 0.0) { yield 0.0 - x } else { yield x }
}

// Square root.
pub fn Void sqrt(x: Float) Float {
  yield x.sqrt
}

// Round toward -infinity.
pub fn Void floor(x: Float) Float {
  yield x.floor
}

// Round toward +infinity.
pub fn Void ceil(x: Float) Float {
  yield x.ceil
}

// Round to the nearest integer.
pub fn Void round(x: Float) Float {
  yield x.round
}

// Round toward zero.
pub fn Void trunc(x: Float) Float {
  yield x.trunc
}

// Float power `base ^ exp`.
pub fn Void powF(base: Float, exp: Float) Float {
  yield base.powF exp
}
