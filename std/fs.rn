// std.fs — file and directory helpers, thin wrappers over portable POSIX
// commands (each documents the command it wraps). Fallible reads return an
// `ExecutableError!String` so callers use `catch`/`try`.
fn Void @() Void

// `test -e` — whether the path exists.
pub fn Void exists(p: String) Bool {
  const r = test "-e" p
  yield (r.exit_code) == 0
}

// `test -d` — whether the path is a directory.
pub fn Void isDir(p: String) Bool {
  const r = test "-d" p
  yield (r.exit_code) == 0
}

// `test -f` — whether the path is a regular file.
pub fn Void isFile(p: String) Bool {
  const r = test "-f" p
  yield (r.exit_code) == 0
}

// `cat` — the file's contents, or an error if it cannot be read.
pub fn Void readText(p: String) ExecutableError!String {
  const r: ExecutableError!String = cat p
  yield r
}

// Write `content` to `p`, truncating (`> p`). `content` is passed unquoted (an
// interpolated redirect source currently deadlocks — see the stdlib plan).
pub fn Void writeText(p: String, content: String) Void {
  echo content > p
}

// Append `content` to `p` (`>> p`).
pub fn Void appendText(p: String, content: String) Void {
  echo content >> p
}

// `ls` — entry names of a directory (empty lines dropped).
pub fn Void listDir(p: String) []String {
  const out: String = "${ls p}"
  var result: []String = .{ }
  for (out.split "\n") |line| {
    if (line.len > 0) { result = result.push line }
  }
  yield result
}

// `mkdir -p` — create the directory and any missing parents.
pub fn Void mkdirp(p: String) Void {
  mkdir "-p" p
}

// `rm -rf` — remove a file or directory tree.
pub fn Void remove(p: String) Void {
  rm "-rf" p
}

// `pwd` — the current working directory (trailing newline stripped).
pub fn Void cwd() String {
  const d: String = "${pwd}"
  yield d.trim
}

// Create a fresh temporary directory, run `body` with it as the working
// directory (a *trailing block* capturing its enclosing scope), then restore the
// previous directory and delete the temp tree — even the clean-up path always
// runs after the block. Use it to scope throwaway work:
//   std.fs.withTempDir {
//     mkdir "sub"; touch "sub/a.txt"
//     echo "made ${ls "sub"}"
//   }
// The block operates in the temp dir via the process working directory, so
// child-process commands (`mkdir`, `touch`, `cp`, `git`, …) land there. NOTE: a
// shell redirect (`echo "x" > f`) currently writes relative to the process's
// original directory, not the temp dir — create files with commands inside the
// block, or use an absolute path.
pub fn Void withTempDir(body: fn() Void) Void {
  const made: String = "${mktemp "-d"}"
  const dir = made.trim
  const prev = cwd
  cd dir
  body
  cd prev
  rm "-rf" dir
}
