// std.testing — assertions for `.rn` module and CLI smoke tests. A failed
// assertion writes a message to stderr and aborts the whole run (`exit 1`).
//
// Each assertion inlines its abort rather than delegating to `fail`: a nested
// statement-position call is not awaited before the outer function returns, so
// a delegated `exit` would race the caller's next statement.
fn Void @() Void

// Unconditionally abort with `msg`.
pub fn Void fail(msg: String) Void {
  echo "assertion failed: ${msg}" 1>&2
  exit 1
}

// Abort with `msg` unless `cond` holds.
pub fn Void assert(cond: Bool, msg: String) Void {
  if (cond) {
    // ok
  } else {
    echo "assertion failed: ${msg}" 1>&2
    exit 1
  }
}

// Abort with `msg` unless the block yields true. The condition is a *trailing
// block* (a `fn () Bool` closure), so a multi-step check reads like a built-in:
//   std.testing.check "sorted" { const xs = sort ys; yield xs[0] <= xs[1] }
// The block runs when `check` evaluates it; it captures its enclosing scope like
// any closure. Equivalent to `assert (…) msg`, but the condition can be computed
// inline instead of pre-bound.
pub fn Void check(msg: String, cond: fn() Bool) Void {
  if (cond) {
    // ok
  } else {
    echo "assertion failed: ${msg}" 1>&2
    exit 1
  }
}

// Run a labeled group of checks as a *trailing block*, printing a header first,
// so related assertions read as a titled section:
//   std.testing.group "arithmetic" {
//     std.testing.assertEq (add 2 3) 5 "sum"
//     std.testing.assert (10 > 5) "greater"
//   }
// The block is a `fn () Void` closure capturing its enclosing scope; a failing
// assertion inside it still aborts the whole run. Purely organizational — it
// adds a header and runs the block, it does not catch or count failures. The
// header is diagnostic, so (like the assertions) it is written to stderr — which
// also keeps `group` a `Void` (silent-on-`&1`) function.
pub fn Void group(label: String, body: fn() Void) Void {
  echo "── ${label}" 1>&2
  body
}

// Abort with `msg` unless `a` equals `b` (scalar/string equality).
pub fn Void assertEq(a: |T|, b: T, msg: String) Void {
  if (a == b) {
    // ok
  } else {
    echo "assertion failed: ${msg}" 1>&2
    exit 1
  }
}

// Abort unless `s` contains `sub`.
pub fn Void assertContains(s: String, sub: String) Void {
  if (s.contains sub) {
    // ok
  } else {
    echo "assertion failed: \"${s}\" does not contain \"${sub}\"" 1>&2
    exit 1
  }
}
