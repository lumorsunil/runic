# An anonymous struct literal `.{ … }` returned by `yield` takes its type from
# the enclosing function's declared return type — including a generic application
# (`Maybe(B)`, `Pair(Int)(String)`), whose constructor name is recovered from the
# raw (unresolved) return type. No explicit `Name{ … }` needed.

const Point = struct { x: Int, y: Int }
fn Void origin() Point { yield .{ .x = 0, .y = 0 } }
const o = origin
echo "origin: ${o.x},${o.y}"

fn Pair(comptime A: type, comptime B: type) type { yield struct { a: A, b: B } }
fn Void mkPair() Pair(Int)(String) { yield .{ .a = 1, .b = "hi" } }
const p = mkPair
echo "pair: ${p.a},${p.b}"

# A generic function whose anonymous return infers the applied constructor, and
# whose `null` inhabits the captured optional field.
fn Maybe(comptime T: type) type { yield struct { x: ?T } }
fn Void map(f: fn (|A|) |B|, ma: Maybe(A)) Maybe(B) {
  if (ma.x) |x| yield .{ .x = f(x) } else yield .{ .x = null }
}
fn Void double(n: Int) Int { yield n * 2 }

const some: Maybe(Int) = .{ .x = 21 }
const none: Maybe(Int) = .{ .x = null }
echo "map some: ${(map double some).x orelse 0}"
echo "map none: ${(map double none).x orelse -1}"
