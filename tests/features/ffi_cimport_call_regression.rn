// End-to-end C FFI calls through libffi: double args/return (libm pow/cos),
// int args/return (libc abs), and a string argument marshalled to a C string
// (libc strlen). Covers both a bound result and a call inside interpolation.
const c = import "std/ffi.rn"

const m = cimport "libm.so.6" {
    extern fn pow(base: c.Double, exp: c.Double) c.Double
    extern fn cos(x: c.Double) c.Double
}
echo "pow=${m.pow 2.0 10.0}"
const squared = m.pow 3.0 2.0
echo "squared=${squared}"
echo "cos=${m.cos 0.0}"

const libc = cimport "libc.so.6" {
    extern fn abs(n: c.Int) c.Int
    extern fn strlen(s: c.Str) c.ULong
    extern fn getpid() c.Int
    extern fn setenv(name: c.Str, value: c.Str, overwrite: c.Int) c.Int
    extern fn getenv(name: c.Str) c.Str
}
echo "abs=${libc.abs (0 - 5)}"
echo "strlen=${libc.strlen "hello"}"

// A nullary extern is called bare (no arguments), like a nullary Runic member.
// getpid always returns a positive pid; the Bool renders as an exit code (0).
const pid = libc.getpid
echo "pid_positive=${pid > 0}"

// An extern argument that is itself a Runic function call must be value-captured
// (its yielded result), not forked — a bare call would hand the marshaller a
// thread/exec-result handle instead of the returned value. (The by-value-struct
// form, `DrawRectangleRec (entityRec e) …`, needs the same capture.)
fn Void neg(n: Int) Int { yield 0 - n }
echo "abs_call_arg=${libc.abs (neg 7)}"

// A `cimport` value captured by a *forked* function (here a for-loop body, which
// is not sync-lowered) must still resolve as the extern's library. A cimport is
// an immutable closeable handle, so it is captured by value; the by-reference
// capture used for aliasable structs previously stored the const's slot address,
// which cimport_call could not use as a library (CImportLoadFailed). No local
// re-import of the library is needed inside the function.
fn Void powTwice() Float { for (0..2) |i| yield m.pow 2.0 5.0 }
powTwice
echo ""

// A `c.Str` return (a borrowed `char*`) is copied into a Runic String and
// composes like any string (`.len`, interpolation). Round-tripped through libc
// setenv/getenv so it is deterministic; a NULL return becomes the empty string.
const set_rc = libc.setenv "RUNIC_FFI_TEST" "hello" 1
const got = libc.getenv "RUNIC_FFI_TEST"
echo "cstr_return=${got} len=${got.len}"
const unset = libc.getenv "RUNIC_FFI_UNSET_VAR_XYZ"
echo "cstr_null_len=${unset.len}"
