# A `{ … }` block immediately following a command/function call is sugar for a
# nullary closure argument, so a function taking a `fn() T` parameter reads like a
# built-in block construct. The block captures its enclosing scope (like any nested
# fn value) and runs when the callee invokes the parameter. This lets libraries
# define control-flow-style wrappers — timers, guards, repeats — in plain Runic.

# Void block, run for effects, with a captured `const`.
fn withBrackets(body: fn() Void) Void {
  echo "["
  body
  echo "]"
}
const label = "job"
withBrackets { echo "running ${label}" }

# A comptime count + block: the loop unrolls and invokes the block each time.
fn repeat(comptime n: Int, body: fn() Void) Void {
  for (0..n) |_| { body }
}
repeat 3 { echo "tick" }

# A value-returning block (the closure yields; the wrapper returns it).
fn twice(body: fn() Int) Int {
  const a = body
  const b = body
  yield a + b
}
echo "sum: ${twice { yield 21 }}"

# The explicit anonymous-fn form is equivalent to the block sugar.
withBrackets (fn Void () Void { echo "explicit" })
