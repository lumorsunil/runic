// std.map — a generic association-list map built in Runic. Exercises the full
// surface (empty/set/get/has/len/keys/values/remove) with both String→Int and
// Int→String maps, including replacing an existing key and removing one. Output
// is content this script controls, so it is deterministic.
const std = import "std"

var m = std.map.empty
m = std.map.set m "a" 1
m = std.map.set m "b" 2
m = std.map.set m "a" 99

echo "a=${std.map.get m "a" orelse 0} b=${std.map.get m "b" orelse 0} c=${std.map.get m "c" orelse 0}"
echo "len=${std.map.len m} has-a=${std.map.has m "a"} has-z=${std.map.has m "z"}"

const ks = std.map.keys m
const vs = std.map.values m
echo "k0=${ks[0]} k1=${ks[1]} v0=${vs[0]} v1=${vs[1]}"

m = std.map.remove m "a"
echo "afterRemove len=${std.map.len m} a=${std.map.get m "a" orelse 0} b=${std.map.get m "b" orelse 0}"

var im = std.map.empty
im = std.map.set im 10 "ten"
im = std.map.set im 20 "twenty"
echo "10=${std.map.get im 10 orelse "?"} 20=${std.map.get im 20 orelse "?"} 30=${std.map.get im 30 orelse "?"}"
