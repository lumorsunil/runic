# Pipeline↔param coercion (stdlib Phase 1, decision 2): a stage that is a
# reference to a single-parameter, Void-stdin function receives the upstream
# value in that parameter. So one helper works as a call, a UFCS method, and a
# pipeline stage. (Trailing newlines shown come from `echo`.)
fn Void @() Void

fn Void shout(s: String) String { yield s.upper }

# As a pipeline stage.
echo "hello" | shout

# Chained param stages.
fn Void bracket(s: String) String { yield "[${s.trim}]" }
echo "world" | shout | bracket

# The same function still works as a normal call.
echo "call: ${shout "quiet"}"

# A param-stage mixes with a stdin-typed stage.
fn String echoStdin() String { const s = &0; yield s.trim }
echo "mixed" | shout | echoStdin

# Typed parameters: a typed value (Int/Float) transports through the pipe and
# binds to the parameter as that type (not a stringified copy), so arithmetic in
# the stage body works.
fn Void double(n: Int) Int { yield n + n }
fn Void halve(x: Float) Float { yield x / 2.0 }
echo "int: ${echo "21" | parseInt | double}"
echo "float: ${echo "3.0" | parseFloat | halve}"
