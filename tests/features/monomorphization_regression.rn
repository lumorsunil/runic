// A direct call to a generic function with `|T|` capture parameters is
// monomorphized: a specialization is compiled with the type variables bound to
// the call's concrete argument types. So a type variable used as a value (e.g.
// `${T}` serialization) reflects the actual per-call type, with no runtime type
// information — each distinct type argument gets its own specialization, and the
// same type argument reuses one.

// One type parameter, three call types → three specializations.
fn Void describe(x: |T|) Void {
    echo "${x} is ${T}"
}
describe 5
describe "hi"
describe 3.14

// The same type argument reuses the cached specialization.
describe 10
describe 20

// Multiple type parameters bind independently.
fn Void pair(a: |A|, b: |B|) Void {
    echo "${A} + ${B}"
}
pair 1 "x"
pair "y" 2.0
pair true 0
