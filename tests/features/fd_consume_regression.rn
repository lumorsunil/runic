// `&0 | first` is a *consuming* read: the first one takes the input value; once
// the producer has closed, a second read sees the closed stream (EOF) and yields
// nothing. So this stage emits the value once even though it reads `&0 | first`
// twice. To use a value more than once, bind it: `const n = &0 | first`.

fn Int consume_once() Int {
    yield &0 | first
    yield &0 | first
}

echo "7" | parseInt | consume_once
