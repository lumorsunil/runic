# Two overloads of `map` dispatched by the argument's *constructor*: a
# higher-kinded monad map over `|M|(A)` and a list map over `[]A`. A higher-kinded
# parameter binds `M` to the argument's type constructor, which is always a named
# type — so `|M|(A)` accepts a `Maybe(Int)` (a struct constructor) and rejects a
# `[]Int` (the built-in array), while `[]A` does the opposite. The same `map d …`
# call therefore resolves to the monad overload for a `Maybe` and the list overload
# for an array, with no annotation.

fn Maybe(comptime T: type) type { yield struct { x: ?T } }
fn pure(x: |A|) Maybe(A) { yield .{ .x = x } }
fn bind(ma: Maybe(|A|), f: fn (|A|) Maybe(|B|)) Maybe(B) {
  if (ma.x) |x| yield f x else yield .{ .x = null }
}

# Monad map: over any constructor M that has bind.
fn map(f: fn (|A|) |B|, ma: |M|(A)) M(B) {
  if (@hasMethod(M)("bind")) {
    fn aux(a: A) M(B) { yield pure (f a) }
    yield bind ma aux
  } else {
    @compileError "${M} is not a monad"
  }
}

# List map: over an array.
fn map(f: fn (|A|) |B|, ma: []A) []B {
  var mb: []B = .{ }
  for (ma) |a| mb = mb.push (f a)
  yield mb
}

fn double(n: Int) Int { yield n * 2 }

const some: Maybe(Int) = Maybe{ .x = 21 }
const none: Maybe(Int) = Maybe{ .x = null }
const xs: []Int = .{ 1, 2, 3 }

echo "maybe some: ${(map double some).x orelse -1}"
echo "maybe none: ${(map double none).x orelse -1}"
const ys = map double xs
echo "list: ${ys[0]} ${ys[1]} ${ys[2]}"
