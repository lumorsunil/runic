# User-defined structs (Phases 1-3): declaration, construction, field access,
# nested structs, and struct-typed parameters and returns. Methods (UFCS) are a
# separate phase.
fn Void @() Void

const Point = struct { x: Int, y: Int }

# Construct + read fields.
const p: Point = Point{ .x = 3, .y = 4 }
echo "p.x=${p.x} p.y=${p.y}"

# Mixed field types.
const Rec = struct { name: String, count: Int }
const r: Rec = Rec{ .name = "widget", .count = 42 }
echo "${r.name} x${r.count}"

# Nested structs + nested field access.
const Line = struct { from: Point, to: Point }
const l: Line = Line{ .from = Point{ .x = 0, .y = 0 }, .to = Point{ .x = 3, .y = 4 } }
echo "to.x=${l.to.x} to.y=${l.to.y}"

# A struct-typed parameter, with field access inside the function.
fn Void sumxy(pt: Point) Int { yield pt.x + pt.y }
echo "sum=${sumxy p}"

# A struct return; the caller reads its fields.
fn Void origin() Point { yield Point{ .x = 5, .y = 9 } }
const o = origin
echo "o.x=${o.x} o.y=${o.y}"
