// std.map with **one-level struct keys** (fields are scalars/strings). A struct
// key is hashed structurally (std.meta.hash) in bucketFor and matched with struct
// `==`, so two equal records are the same key. Previously bucketFor did
// `key % count`, invalid on a struct. (Keys whose fields are themselves structs
// are a documented limitation — not exercised here.)
const std = import "std"

const Point = struct { x: Int, y: Int }

var m = std.map.empty
m = std.map.set m Point{ .x = 1, .y = 2 } "a"
m = std.map.set m Point{ .x = 3, .y = 4 } "b"
// An equal struct key replaces the existing entry (not a new one).
m = std.map.set m Point{ .x = 1, .y = 2 } "a2"

echo "get (1,2): ${std.map.get m Point{ .x = 1, .y = 2 } orelse "?"}"
echo "get (3,4): ${std.map.get m Point{ .x = 3, .y = 4 } orelse "?"}"
echo "get (9,9): ${std.map.get m Point{ .x = 9, .y = 9 } orelse "?"}"
echo "has (3,4): ${std.map.has m Point{ .x = 3, .y = 4 }}"
echo "has (9,9): ${std.map.has m Point{ .x = 9, .y = 9 }}"
echo "len: ${std.map.len m}"

// A struct key with a string field also works.
const Named = struct { id: Int, tag: String }
var n = std.map.empty
n = std.map.set n Named{ .id = 1, .tag = "a" } "first"
echo "named: ${std.map.get n Named{ .id = 1, .tag = "a" } orelse "?"}"

// Int keys still work unchanged.
var k = std.map.empty
k = std.map.set k 7 "seven"
echo "int key: ${std.map.get k 7 orelse "?"}"
