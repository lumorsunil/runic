// Semicolon acts as a statement separator, equivalent to a newline.

cd "/tmp"; bash "-c" "pwd"

// Multiple semicolons in sequence
bash "-c" "echo one"; bash "-c" "echo two"; bash "-c" "echo three"

// Semicolon with assignment and command
const x = "hello"; echo "${x}"

// Parenthesized command sequence
(echo "hello"; echo "cat")

// A `;` after ANY binding is a plain statement separator — the initializer is
// exactly the expression to the right of `=`, and the following statement is its
// own. This holds for value bindings…
const v = 5
const w = v; echo "w=${w}"
const s = 1 + 2; echo "s=${s}"

// …and for command-producing bindings: the next statement is NOT folded into the
// binding's value, so it can reference the just-bound variable. (A binding
// followed by `;` then a `yield`, a closing `}`, or a use of the binding all just
// work.)
const parsed = echo "42" | parseInt catch 0; echo "parsed=${parsed}"
const proc = printf "cap\n"; echo "proc=[${proc.stdout}]"
fn Void pick() Int { const n = echo "7" | parseInt catch 0; yield n }
echo "pick=${pick}"
fn Void last() Void { const z = echo "5" | parseInt catch 0; }
last

// To capture a command *sequence*, use `&&`/`||` (one expression) or a subshell.
const chained = printf "x" && printf "y"; echo "chained=[${chained.stdout}]"
const sub = $(echo "a"; echo "b"); echo "sub=[${sub}]"
