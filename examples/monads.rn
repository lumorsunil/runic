# The Maybe monad: an optional value wrapped in a struct, plus a `map` that
# applies a function when the value is present and propagates "nothing"
# otherwise.
#
# `map` takes a *function-type* parameter. A function type literal is written
# `fn (ParamTypes...) ReturnType` — the parameters are bare types (no names, no
# stdin type). Its argument and return types can be captured with `|A|` / `|B|`,
# so `fn (|A|) |B|` is "any function from A to B" and binds A and B for the rest
# of the signature (`ma: Maybe(A)` in, `Maybe(B)` out).

fn Maybe(comptime T: type) type {
  yield struct { x: ?T }
}

fn Void map(f: fn (|A|) |B|, ma: Maybe(A)) Maybe(B) {
  if (ma.x) |x| yield Maybe{ .x = f(x) } else yield Maybe{ .x = null }
}

fn Void double(n: Int) Int { yield n * 2 }
fn Void label(n: Int) String { yield "n=${n}" }

const some: Maybe(Int) = Maybe{ .x = 21 }
const none: Maybe(Int) = Maybe{ .x = null }

# The captured return type B follows the mapped function: Int for `double`,
# String for `label`.
echo "double(some): ${(map double some).x orelse 0}"
echo "label(some):  ${(map label some).x orelse "?"}"
echo "double(none): ${(map double none).x orelse -1}"
